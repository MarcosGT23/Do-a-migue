---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminDashboard from '../../components/admin/AdminDashboard';
import { obtenerContextoSesion } from '../../core/sessionContext';

const sesion = await obtenerContextoSesion(Astro.cookies);
if (!sesion.autenticado) {
  return Astro.redirect('/login');
}
if (!sesion.esAdminOSupervisor) {
  return Astro.redirect('/pos');
}

const { data: pedidosData } = await sesion.supabaseSSR
  .from('pedidos')
  .select('id, cliente_nombre, numero_mesa, total, estado, created_at')
  .eq('sucursal_id', sesion.sucursalId)
  .order('created_at', { ascending: false })
  .limit(25);

const { data: kardexData } = await sesion.supabaseSSR
  .from('movimientos_inventario')
  .select('id, tipo, cantidad, stock_anterior, stock_resultante, motivo, created_at, productos ( nombre )')
  .eq('sucursal_id', sesion.sucursalId)
  .order('created_at', { ascending: false })
  .limit(20);

const kardexFormateado = (kardexData || []).map((m: any) => ({
  id: m.id,
  producto_nombre: m.productos?.nombre || 'Producto',
  tipo: m.tipo,
  cantidad: m.cantidad,
  stock_anterior: m.stock_anterior,
  stock_resultante: m.stock_resultante,
  motivo: m.motivo || 'Sin observación',
  created_at: m.created_at,
}));

const { data: stockData } = await sesion.supabaseSSR
  .from('inventario')
  .select('stock_actual, stock_minimo, productos ( id, nombre )')
  .eq('sucursal_id', sesion.sucursalId);

const productosStock = (stockData || [])
  .filter((s: any) => s.productos)
  .map((s: any) => ({
    id: s.productos.id,
    nombre: s.productos.nombre,
    stock_actual: s.stock_actual,
    stock_minimo: s.stock_minimo,
  }));
---

<AdminLayout title="Dashboard y Kardex">
  <AdminDashboard
    client:load
    sucursalId={sesion.sucursalId}
    adminUsuarioId={sesion.usuarioId}
    pedidosIniciales={pedidosData || []}
    kardexInicial={kardexFormateado}
    productosStock={productosStock}
  />
</AdminLayout>

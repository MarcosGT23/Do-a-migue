---
import { ClientRouter } from 'astro:transitions';
import AdminSidebar from '../components/admin/AdminSidebar';
import { obtenerContextoSesion } from '../core/sessionContext';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const rutaActual = Astro.url.pathname;
const sesion = await obtenerContextoSesion(Astro.cookies);

if (!sesion.autenticado) {
  return Astro.redirect('/login');
}

if (!sesion.esAdminOSupervisor) {
  return Astro.redirect('/pos');
}
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#14110f" />
    <title>{title} | Doña Migue Administración</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class="flex h-dvh overflow-hidden bg-app text-ink antialiased">
    <AdminSidebar
      client:load
      rutaActual={rutaActual}
      adminNombre={sesion.nombreCompleto}
      sucursalNombre={sesion.sucursalNombre}
    />
    <main class="h-full flex-1 overflow-y-auto pt-14 lg:pt-0">
      <slot />
    </main>
  </body>
</html>

---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Doña Migue POS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <style is:global>
      /* Ocultar el portal de impresión en pantalla regular */
      #ticket-termico-impresion-portal {
        display: none !important;
      }

      /* 🖨️ Reglas de Impresión Térmica Directa a 0mm */
      @media print {
        @page {
          size: 80mm 297mm;
          margin: 0mm !important;
        }

        *, *::before, *::after {
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }

        html, body {
          background: #ffffff !important;
          color: #000000 !important;
          margin: 0mm !important;
          padding: 0mm !important;
          width: 100% !important;
          height: auto !important;
          min-height: 0 !important;
          overflow: visible !important;
        }

        /* Oculta toda la aplicación para que no ocupe espacio de flujo */
        body > * {
          display: none !important;
        }

        /* Único elemento visible en la página impreso en la coordenada top: 0mm */
        body > #ticket-termico-impresion-portal {
          display: block !important;
          visibility: visible !important;
          position: absolute !important;
          top: 0mm !important;
          left: 0mm !important;
          right: 0mm !important;
          margin: 0 auto !important;
          margin-top: 0mm !important;
          padding: 0mm 2.5mm 3mm 2.5mm !important;
          padding-top: 0mm !important;
          background: #ffffff !important;
          box-sizing: border-box !important;
          font-family: 'Courier New', Courier, monospace !important;
          box-shadow: none !important;
          border: none !important;
        }

        body > #ticket-termico-impresion-portal * {
          visibility: visible !important;
        }

        .ticket-ancho-80mm {
          width: 72mm !important;
          max-width: 72mm !important;
          font-size: 11px !important;
          line-height: 1.25 !important;
        }

        .ticket-ancho-58mm {
          width: 48mm !important;
          max-width: 48mm !important;
          font-size: 9.5px !important;
          line-height: 1.15 !important;
        }

        .no-print {
          display: none !important;
        }
      }
    </style>
  </head>
  <body class="bg-[#100f0e] text-[#ede7dc] h-screen w-screen overflow-hidden select-none antialiased">
    <slot />
  </body>
</html>


---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#14110f" />
    <title>{title} | Doña Migue POS</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class="h-dvh w-full overflow-hidden bg-app text-ink antialiased">
    <slot />
    {import.meta.env.DEV && (
      <script is:inline>
        (() => {
          const mostrar = (titulo, detalle) => {
            let caja = document.getElementById('pos-diagnostico');
            if (!caja) {
              caja = document.createElement('div');
              caja.id = 'pos-diagnostico';
              caja.style.cssText = 'position:fixed;left:8px;right:8px;bottom:8px;z-index:99999;background:#7f1d1d;color:#fff;font:600 12px/1.45 ui-monospace,monospace;padding:10px 12px;border-radius:10px;box-shadow:0 12px 30px rgba(0,0,0,.5);white-space:pre-wrap;';
              document.body.appendChild(caja);
            }
            caja.textContent = titulo + (detalle ? '\n' + detalle : '') + '\n(recarga con Ctrl+Shift+R; este aviso solo aparece en desarrollo)';
          };
          addEventListener('error', (e) => {
            if (e.target && e.target.tagName === 'SCRIPT') {
              mostrar('No se pudo cargar un script de la página.', e.target.src || '');
              return;
            }
            mostrar('Error de JavaScript:', e.message || String(e.error || e));
          }, true);
          addEventListener('unhandledrejection', (e) => {
            const r = e.reason;
            mostrar('Promesa rechazada sin manejar:', (r && (r.stack || r.message)) || String(r));
          });
          setTimeout(() => {
            if (!window.__posHidratado) {
              mostrar('La interfaz no se inicializó (React no arrancó).', 'Puede ser caché o un script bloqueado. Fuerza la recarga.');
            }
          }, 3000);
        })();
      </script>
    )}
  </body>
</html>
